# VaultRecon AI Environment Configuration Example

# LLM Provider Configuration (gemini or openai or mock)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Or OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# API Keys (Set your API key here or via shell export)
# Do NOT commit actual keys to git.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage & Engine Settings
VAULT_DB_DIR=./data_vault
MEMTABLE_SIZE_MB=32

# Reconciliation Thresholds & Tolerance
AMOUNT_TOLERANCE=0.01
TIMESTAMP_TOLERANCE_HOURS=72
DEFAULT_CONFIDENCE_THRESHOLD=0.85

